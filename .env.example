# ==========================================
# StockPilot AI - Root Environment Config
# ==========================================

# Application Environment
APP_ENV=development
APP_NAME=StockPilot AI

# Backend FastAPI Settings
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database Settings (Supabase / PostgreSQL or local SQLite fallback)
# Production example: postgresql+psycopg://postgres.your-ref:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=sqlite+aiosqlite:///./stockpilot.db
DATABASE_SYNC_URL=sqlite:///./stockpilot.db

# Authentication (JWT)
JWT_SECRET_KEY=dev-stockpilot-super-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Market Data Providers
MARKET_DATA_PROVIDER=nse_yahoo_fallback
MARKET_DATA_API_KEY=

# ML Model Settings
MODEL_ARTIFACT_PATH=ml/artifacts/stockpilot_model.joblib
MODEL_METADATA_PATH=ml/artifacts/model_metadata.json
MODEL_VERSION=1.0.0

# Frontend Next.js Settings (apps/web)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=StockPilot AI
